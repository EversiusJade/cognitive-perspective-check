{
  "protocol_version": "1.0",
  "target_skill_version": "0.2.0-rc.4",
  "run_status": "not_run",
  "purpose": "诊断相对收益、短提示对照、路由证据、交付与可观察成本",
  "prefix_location": "只在固定messages最后一条user内容前添加；不重复添加到控制者后续回复",
  "conditions": {
    "C0": {
      "target_skill_visible": false,
      "prefix": ""
    },
    "Cs": {
      "target_skill_visible": false,
      "prefix": "先理解关键背景，只补问会改变判断的信息；保留用户明确的目标和约束，检查用户与 AI 的预设，比较少量有依据且会改变行动或取舍的视角，说明条件建议；已明确的任务或已选分支直接交付，不重复展开。\n"
    },
    "C1": {
      "target_skill_visible": true,
      "prefix": ""
    },
    "C2": {
      "target_skill_visible": true,
      "prefix": "使用 cognitive-perspective-check。\n"
    }
  },
  "controller_policy": {
    "reply_only_to_asked_fact_fields": true,
    "unknown_reply": "暂不清楚，请保留为未知，按现有信息作条件分析。",
    "menu_only_followup": "请基于已有信息给出当前范围内可用的简短方案；未知处保持条件性，不展开其他分支。",
    "unknown_reply_en": "I do not know yet. Keep it unknown and give a conditional analysis using the available information.",
    "menu_only_followup_en": "Please provide a usable brief proposal within the current scope using the available information. Keep unknowns conditional and do not expand other branches.",
    "reply_language": "与场景原始用户任务语言一致。",
    "max_menu_only_followups": 1,
    "stop_when": [
      "先检查助手轮数上限，不再发超限用户回复",
      "无背景问题且已提交请求的成果形式；质量留给后续评分",
      "一次菜单补救后再次只有菜单",
      "无问题/成果/可补救菜单的有效输出，包含拒绝或错误改目标"
    ],
    "optional_menu_after_delivery": "不算待答背景问题，不为改善质量强迫继续。",
    "repeat_question_policy": "重复相同已给信息，不增加新事实；继续计入信息请求成本",
    "value_choice_policy": "保持事实卡的优先级；不替用户增加未授权深入分支",
    "compound_question_count": "按独立信息项拆分，不按问号计",
    "answer_over_cap_questions": true
  },
